# Copy to .env and fill in. Never commit .env.

# --- required for LLM features (Phase 2) ---
GROQ_API_KEY=
# Contact address sent to Crossref / OpenAlex / NCBI (their "polite pool")
CONTACT_EMAIL=you@example.org

# --- optional but recommended: free keys with much higher limits ---
# OpenAlex: anonymous use shares a small daily budget per IP (https://openalex.org/settings/api)
OPENALEX_API_KEY=
S2_API_KEY=
NCBI_API_KEY=

# --- auth: an admin key accepted by the API (create per-user keys with `citeguard create-key`) ---
AUTH_ENABLED=true
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- LLM budget (Groq free tier: 30 RPM, 8K TPM, 200K TPD per model) ---
LLM_TPM=8000
LLM_TPD=200000
# LLM_DAILY_TOKEN_BUDGET=150000

# --- docker compose ---
POSTGRES_PASSWORD=citeguard
WEB_PORT=8080
# set to http://grobid:8070 when running with `--profile pdf`
GROBID_URL=
