    ],
    "title": "Author"
   },
   "Body_upload_check_api_v1_checks_upload_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     },
     "options": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Options",
      "description": "CheckOptions as JSON"
     }
    },
    "type": "object",
    "required": [
     "file"
    ],
    "title": "Body_upload_check_api_v1_checks_upload_post"
   },
   "Candidate": {
    "properties": {
     "record": {
      "$ref": "#/components/schemas/Record"
     },
     "features": {
      "$ref": "#/components/schemas/MatchFeatures"
     },
     "probability": {
      "type": "number",
      "title": "Probability"
     },
     "evidence_id": {
      "type": "string",
      "title": "Evidence Id"
     }
    },
    "type": "object",
    "required": [
     "record",
     "features",
     "probability",
     "evidence_id"
    ],
    "title": "Candidate"
   },
   "CheckCreate": {
    "properties": {
     "text": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000000
       },
       {
        "type": "null"
       }
      ],
      "title": "Text"
     },
     "bibtex": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000000
       },
       {
        "type": "null"
       }
      ],
      "title": "Bibtex"
     },
     "citation": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 5000
       },
       {
        "type": "null"
       }
      ],
      "title": "Citation"
     },
     "options": {
      "$ref": "#/components/schemas/CheckOptions"
     }
    },
    "type": "object",
    "title": "CheckCreate",
    "description": "Exactly one of `text`, `bibtex` or `citation`."
   },
   "CheckCreated": {
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid",
      "title": "Id"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "links": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Links"
     }
    },
    "type": "object",
    "required": [
     "id",
     "status",
     "links"
    ],
    "title": "CheckCreated"
   },
   "CheckListItem": {
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid",
      "title": "Id"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "input_kind": {
      "type": "string",
      "title": "Input Kind"
     },
     "filename": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Filename"
     },
     "progress_total": {
      "type": "integer",
      "title": "Progress Total"
     },
     "progress_done": {
      "type": "integer",
      "title": "Progress Done"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Summary"
     }
    },
    "type": "object",
    "required": [
     "id",
     "status",
     "input_kind",
     "filename",
     "progress_total",
     "progress_done",
     "created_at",
     "summary"
    ],
    "title": "CheckListItem"
   },
   "CheckOptions": {
    "properties": {
     "use_llm": {
      "type": "boolean",
      "title": "Use Llm",
      "default": true
     },
     "explain": {
      "type": "boolean",
      "title": "Explain",
      "default": true
     },
     "suggest_alternatives": {
      "type": "boolean",
      "title": "Suggest Alternatives",
      "default": true
     },
     "styles": {
      "items": {
       "type": "string",
       "enum": [
        "apa",
        "ieee",
        "bibtex"
       ]
      },
      "type": "array",
      "title": "Styles"
     },
     "sources": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sources"
     },
     "check_claims": {
      "type": "boolean",
      "title": "Check Claims",
      "description": "Check whether each real paper's abstract supports the sentences citing it (needs the LLM and in-text citations; a hint, not a verdict).",
      "default": false
     },
     "claim": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000
       },
       {
        "type": "null"
       }
      ],
      "title": "Claim",
      "description": "Single-citation input only: the sentence the citation is meant to support. Implies check_claims."
     }
